# Copy to .env.local (for `npm run dev`) and .env (for docker compose), then fill in.

# --- Local MongoDB in Docker (docker compose reads these) ---
MONGO_ROOT_USER=mjadmin
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string
# Host port. Use 27018 if a MongoDB is already installed locally on 27017.
MONGO_PORT=27017

# --- App ---
# Local Docker:  mongodb://mjadmin:<password>@localhost:27017/?authSource=admin
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mjadmin:change-me-to-a-long-random-string@localhost:27017/?authSource=admin
MONGODB_DB=mjdeveloper

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Needed once, to create the first admin at /admin/setup. 12+ characters.
SETUP_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
